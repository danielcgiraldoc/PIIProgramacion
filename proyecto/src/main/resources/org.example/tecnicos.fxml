<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #F4F7FB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.TecnicosViewController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="76.0" spacing="12.0" style="-fx-background-color: #142B4A;">
            <padding>
                <Insets bottom="14.0" left="34.0" right="34.0" top="14.0" />
            </padding>
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label prefHeight="92.0" prefWidth="178.0" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Técnicos y costos" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnVolver" onAction="#volverInicio" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #8296AE; -fx-border-radius: 7px; -fx-background-radius: 7px;" text="Volver al inicio">
               <font>
                  <Font size="15.0" />
               </font></Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="4.0" />

                <HBox prefHeight="145.0" spacing="16.0">
                    <children>
                        <VBox minWidth="420.0" prefWidth="420.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #DCE4EE; -fx-border-radius: 12px;">
                            <padding>
                                <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #142B4A; -fx-font-size: 16px; -fx-font-weight: bold;" text="Disponibilidad de técnicos" />
                                <HBox spacing="10.0">
                                    <children>
                                        <ComboBox fx:id="cmbEspecialidad" prefHeight="36.0" promptText="Selecciona una especialidad" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnConsultarTecnico" onAction="#consultarTecnico" prefHeight="36.0" style="-fx-background-color: #2878C8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7px;" text="Consultar">
                                 <font>
                                    <Font size="15.0" />
                                 </font></Button>
                                    </children>
                                </HBox>
                                <Label fx:id="lblResultadoTecnico" style="-fx-text-fill: #5B6B7F; -fx-font-size: 14px;" text="Selecciona una especialidad para consultar." wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="9.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #DCE4EE; -fx-border-radius: 12px;" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #142B4A; -fx-font-size: 16px; -fx-font-weight: bold;" text="Resultado de la consulta" />
                                <HBox spacing="28.0">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #718096; -fx-font-size: 14px;" text="Técnico" />
                                                <Label fx:id="lblDocumentoTecnico" style="-fx-text-fill: #35465C; -fx-font-size: 14px; -fx-font-weight: bold;" text="—" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #718096; -fx-font-size: 14px;" text="Disponibilidad" />
                                                <Label fx:id="lblDisponibilidadTecnico" style="-fx-text-fill: #35465C; -fx-font-size: 14px; -fx-font-weight: bold;" text="—" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #718096; -fx-font-size: 14px;" text="Desplazamiento" />
                                                <Label fx:id="lblCostoDesplazamiento" style="-fx-text-fill: #2878C8; -fx-font-size: 14px; -fx-font-weight: bold;" text="0 COP" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="9.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #142B4A; -fx-font-size: 16px; -fx-font-weight: bold;" text="Solicitudes registradas" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnActualizarSolicitudes" onAction="#actualizarSolicitudes" prefHeight="34.0" style="-fx-background-color: white; -fx-text-fill: #2878C8; -fx-font-weight: bold; -fx-border-color: #B8CCE2; -fx-border-radius: 7px; -fx-background-radius: 7px;" text="Actualizar lista" />
                            </children>
                        </HBox>

                        <TableView fx:id="tablaSolicitudes" onMouseClicked="#seleccionarSolicitud" style="-fx-background-color: white; -fx-background-radius: 10px;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigoSolicitud" prefWidth="130.0" text="Código" />
                                <TableColumn fx:id="colCliente" prefWidth="260.0" text="Cliente" />
                                <TableColumn fx:id="colFechaCreacion" prefWidth="160.0" text="Fecha" />
                                <TableColumn fx:id="colAtencionPresencial" prefWidth="140.0" text="Presencial" />
                                <TableColumn fx:id="colCostoTotal" prefWidth="210.0" text="Costo total" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button fx:id="btnRecalcularCosto" onAction="#recalcularCosto" prefHeight="36.0" style="-fx-background-color: #142B4A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7px;" text="Recalcular costo seleccionado">
                           <font>
                              <Font size="15.0" />
                           </font></Button>
                                <Region HBox.hgrow="ALWAYS" />
                                  <Label style="-fx-text-fill: #718096; -fx-font-size: 15px;" text="Costo de la solicitud seleccionada" />
                                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                    <children>
                                        <Label fx:id="lblCostoSolicitudSeleccionada" style="-fx-text-fill: #2878C8; -fx-font-size: 18px; -fx-font-weight: bold;" text="0 COP" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
